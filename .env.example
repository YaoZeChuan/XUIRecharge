# Copy to .env for local development. Replace the placeholder secrets before use.
APP_ENV=development
CONFIG_FILE=configs/config.example.yaml
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
DATABASE_PATH=./data/recharge.db

# mock subscription IDs: user001-sub, expired-demo-sub, unlimited-demo-sub. Set to real for a panel.
PANEL_MODE=mock
PANEL_BASE_URL=https://panel.example.com/your-panel-path
PANEL_API_TOKEN_ENV=PANEL_API_TOKEN
PANEL_API_TOKEN=replace-with-a-panel-api-token
# Optional 3x-ui session cookie for panels that require browser-session authentication.
PANEL_COOKIE=
PANEL_TIMEOUT_SECONDS=10
PANEL_TLS_VERIFY=true

# Optional official LDC integration. Set PUBLIC_BASE_URL to the public HTTPS origin.
# Register the public key matching this merchant Ed25519 private key in the LDC console.
# The private key accepts PKCS#8 PEM or base64-encoded 32-byte seed / 64-byte private key.
LDC_BASE_URL=https://credit.linux.do
PUBLIC_BASE_URL=
LDC_CLIENT_ID=
LDC_CLIENT_SECRET=
LDC_ED25519_PRIVATE_KEY=
LDC_POLL_INTERVAL_SECONDS=30

# Use at least 32 random bytes for the session secret.
SESSION_SECRET=replace-with-a-different-32-random-bytes-before-running

ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-this-with-a-unique-password-12-chars-or-longer
ADMIN_SESSION_HOURS=12
